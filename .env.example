# Copy to .env for local runs. On Railway (or any host) set these as service variables.
# Never commit real values.

# ---- Required ---------------------------------------------------------------

# The assistant's Telegram account (a spare number). From https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=
# Made by `python login.py` (run it on your own computer, once). Keep it secret.
TG_SESSION=

# YOUR Telegram numeric user ID. The service can call and text ONLY this person.
OWNER_TG_ID=

# ElevenLabs API key and the outbound agent (see agent/prompt.md).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Shared secret that Claude sessions send as "Authorization: Bearer <token>".
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLER_TOKEN=

# ---- Personal touch (optional) ---------------------------------------------

# How the assistant greets you, and what it calls itself.
OWNER_NAME=
ASSISTANT_NAME=Jessica
# Your time zone (IANA name), so the assistant knows your local time.
TIMEZONE=UTC

# ---- Calling in (optional) ---------------------------------------------------

# A second agent, for when you call the assistant (see agent/inbox-prompt.md).
ELEVENLABS_INBOUND_AGENT_ID=

# ---- Notes repo (optional) ---------------------------------------------------

# Save every call, text reply and worker result as a markdown file in one GitHub repo,
# and give the inbound agent a few files from it as context.
# Fine-grained token: only that repo, permission "Contents: Read and write".
GITHUB_TOKEN=
NOTES_REPO=            # owner/repo
NOTES_DIR=raw/voice-notes
CONTEXT_FILES=         # comma-separated paths, e.g. wiki/hot.md,wiki/index.md

# ---- Background worker (optional, see README) ---------------------------------

WORKER_URL=            # e.g. http://claude-worker.railway.internal:8080
WORKER_TOKEN=

# ---- Tuning (optional) -------------------------------------------------------
# PORT=8080
# RING_SECONDS=45
# MAX_CALL_SECONDS=600
# DATA_DIR=./data
